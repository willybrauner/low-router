{
  "name": "example-preact-ssr-lazy-routes",
  "private": "true",
  "main": "src/index-client.tsx",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx server.dev.ts",
    "build:spa": "cross-env VITE_SPA=true vite build --outDir dist/spa",
    "build:ssr-scripts": "vite build -c vite.ssr-scripts.config.ts",
    "build:ssr-client": "vite build --outDir dist/ssr/client",
    "build:ssr-server": "vite build --ssr src/index-server.tsx --outDir dist/ssr/server",
    "build:ssr": "npm run build:ssr-scripts && npm run build:ssr-client && npm run build:ssr-server",
    "build": "npm run build:spa && npm run build:ssr",
    "start": "cross-env NODE_ENV=production node dist/ssr/scripts/server.prod.js",
    "reset": "rm -rf dist node_modules package-lock.json pnpm-lock.yaml tsconfig.tsbuildinfo",
    "reinstall": "pnpm reset && pnpm install"
  },
  "dependencies": {
    "@wbe/debug": "^3.2.0",
    "@wbe/interpol": "^0.31.4",
    "@wbe/low-router": "workspace:*",
    "@wbe/low-router-preact": "workspace:*",
    "@wbe/utils": "^0.3.1",
    "fastify": "^5.8.2",
    "gsap": "^3.14.2",
    "path-to-regexp": "^8.3.0",
    "preact": "^10.29.0",
    "preact-render-to-string": "^6.6.6"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.1",
    "@preact/preset-vite": "^2.10.4",
    "@types/events": "^3.0.3",
    "@types/node": "^25.5.0",
    "@wbe/mfs": "^0.3.0",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "portfinder-sync": "^0.0.2",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "sirv": "^3.0.2",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.12.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100
  }
}
